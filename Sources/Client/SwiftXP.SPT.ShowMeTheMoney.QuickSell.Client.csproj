<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <AssemblyName>SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client</AssemblyName>
    <Product>Show Me The Money - Quick Sell</Product>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <LicenseToolPath>$(HOME)/.dotnet/tools/dotnet-project-licenses</LicenseToolPath>
    <LicenseToolPath Condition="'$(OS)' == 'Windows_NT'">
      $(UserProfile)\.dotnet\tools\dotnet-project-licenses.exe</LicenseToolPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" /> -->
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <!--
    Resolve everything from an SPT install rather than from a hand-populated spt4-shared-dlls folder
    next to the repo. That folder has to be filled in by hand, and when it is missing - which it is
    on a fresh clone - every reference silently fails to resolve. Override the install path per build
    with -p:SPTPath=... ; the default below only applies when nothing is passed in.
  -->
  <PropertyGroup>
    <SPTPath Condition="'$(SPTPath)' == ''">E:\SPT 4.0.10</SPTPath>
    <ShowMeTheMoneyPluginPath Condition="'$(ShowMeTheMoneyPluginPath)' == ''">$(SPTPath)\BepInEx\plugins\com.swiftxp.spt.showmethemoney</ShowMeTheMoneyPluginPath>
    <AssemblySearchPaths>
      $(AssemblySearchPaths);
      $(SPTPath)\EscapeFromTarkov_Data\Managed;
      $(SPTPath)\BepInEx\core;
      $(SPTPath)\BepInEx\plugins\spt;
    </AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Show Me The Money is referenced from the installed plugin rather than from a sibling clone's
      bin folder. The old path assumed the repository sat next to this one under the exact name
      "spt-show-me-the-money" and had been built in Release, which is not true for a clone in any
      other folder. Build Show Me The Money first - it copies itself into the install - then build
      this.
    -->
    <Reference Include="$(ShowMeTheMoneyPluginPath)\SwiftXP.SPT.ShowMeTheMoney.Client.dll" />

    <Reference Include="Assembly-CSharp" />
    <Reference Include="BepInEx" />
    <Reference Include="Comfort" />
    <Reference Include="Sirenix.Serialization" />
    <Reference Include="spt-common" />
    <Reference Include="spt-reflection" />
    <Reference Include="UnityEngine.UI" />
  </ItemGroup>

  <!-- Drop the built plugin straight into the install, so no file has to be copied by hand. -->
  <Target Name="CopyToSPT" AfterTargets="AfterBuild" Condition="Exists('$(SPTPath)')">
    <MakeDir Directories="$(SPTPath)\BepInEx\plugins\com.swiftxp.spt.showmethemoney.quicksell" />
    <Copy SourceFiles="$(TargetPath)"
      DestinationFolder="$(SPTPath)\BepInEx\plugins\com.swiftxp.spt.showmethemoney.quicksell" />
  </Target>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="GenerateLicenseFile" AfterTargets="Publish">
    <Message Text="Generating license file..." Importance="high" />

    <Exec
      Command="$(LicenseToolPath) --input &quot;$(MSBuildProjectFullPath)&quot; --output --outfile &quot;$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client.LICENSES.txt&quot;"
      EnvironmentVariables="DOTNET_ROLL_FORWARD=Major"
      ConsoleToMSBuild="true"
      IgnoreExitCode="false" />

    <Message Text="License file generated." Importance="high" />
  </Target>

  <Target Name="CopyToPublishFolder" AfterTargets="GenerateLicenseFile">
    <Message Text="Copying published files to /Publish folder..." Importance="high" />

    <ItemGroup>
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client.dll" />
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client.LICENSES.txt" />
    </ItemGroup>

    <Copy SourceFiles="@(PublishedFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)/../../Publish/BepInEx/plugins/com.swiftxp.spt.showmethemoney.quicksell" />
  </Target>
</Project>
