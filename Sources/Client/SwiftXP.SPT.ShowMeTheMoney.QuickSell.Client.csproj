<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>2.4.0</Version>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <AssemblyName>SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client</AssemblyName>
    <Product>Show Me The Money - Quick Sell</Product>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <LicenseToolPath>$(HOME)/.dotnet/tools/dotnet-project-licenses</LicenseToolPath>
    <LicenseToolPath Condition="'$(OS)' == 'Windows_NT'">
      $(UserProfile)\.dotnet\tools\dotnet-project-licenses.exe</LicenseToolPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(MSBuildThisFileDirectory)/../../../spt-show-me-the-money/Sources/Client/bin/Release/netstandard2.1/SwiftXP.SPT.ShowMeTheMoney.Client.dll" Private="false" />

    <Reference Include="$(SptBepInEx)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(SptManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(SptBepInEx)\core\BepInEx.dll" Private="false" />
    <Reference Include="$(SptManaged)\Comfort.dll" Private="false" />
    <Reference Include="$(SptManaged)\Sirenix.Serialization.dll" Private="false" />
    <Reference Include="$(SptBepInEx)\plugins\spt\spt-common.dll" Private="false" />
    <Reference Include="$(SptBepInEx)\plugins\spt\spt-reflection.dll" Private="false" />
    <Reference Include="$(SptManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(SptManaged)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="GenerateLicenseFile" AfterTargets="Publish">
    <Message Text="Generating license file..." Importance="high" />

    <Exec
      Command="$(LicenseToolPath) --input &quot;$(MSBuildProjectFullPath)&quot; --output --outfile &quot;$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client.LICENSES.txt&quot;"
      EnvironmentVariables="DOTNET_ROLL_FORWARD=Major"
      ConsoleToMSBuild="true"
      IgnoreExitCode="false" />

    <Message Text="License file generated." Importance="high" />
  </Target>

  <Target Name="CopyToPublishFolder" AfterTargets="GenerateLicenseFile">
    <Message Text="Copying published files to /Publish folder..." Importance="high" />

    <ItemGroup>
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client.dll" />
      <PublishedFiles Include="$(PublishDir)SwiftXP.SPT.ShowMeTheMoney.QuickSell.Client.LICENSES.txt" />
    </ItemGroup>

    <Copy SourceFiles="@(PublishedFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)/../../Publish/BepInEx/plugins/com.swiftxp.spt.showmethemoney.quicksell" />
  </Target>
</Project>
